# Copy this file to .env and fill it in. Never share or commit .env.

# Set to 1 on your own computer so the login works over http. Leave it out on Render.
DEBUG=1

# A long random value. Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The password for the admin page. At least 12 characters.
ADMIN_PASSWORD=

# Leave empty to use a local file (quotes.db). On Render, use your MySQL address:
DATABASE_URL=
# Format: mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME

# Your website. FRONTEND_ORIGINS lists the sites allowed to send quote requests (separate several with commas).
FRONTEND_URL=https://portfolio.shakaaraahllc.com
FRONTEND_ORIGINS=https://portfolio.shakaaraahllc.com

# Email, sent through Resend (resend.com). The sender must use a domain you have verified there.
RESEND_API_KEY=
MAIL_DEFAULT_SENDER=Shakaaraah Communications <noreply@shakaaraahllc.com>
MAIL_REPLY_TO=digital@shakaaraahllc.com
TEAM_NOTIFICATION_EMAILS=digital@shakaaraahllc.com
